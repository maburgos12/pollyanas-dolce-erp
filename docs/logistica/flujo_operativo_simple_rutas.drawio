        <mxCell id="e12" value="siguiente tramo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b26a00;fontSize=12;" edge="1" parent="1" source="n10" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
