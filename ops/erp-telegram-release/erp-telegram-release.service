[Unit]
Description=Publish only the exact ERP revision approved in private Telegram
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /usr/local/libexec/erp-point-decision/erp_telegram_release.py worker
LoadCredential=telegram.json:/etc/erp-mac-ia-watchdog/telegram.json
StateDirectory=erp-point-decision
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=2400
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/opt/pastelerias-erp /run/lock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=512M
TasksMax=128
