[Unit]
Description=Publish only the exact ERP revision approved in private Telegram
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /usr/local/libexec/erp-point-decision/erp_telegram_release.py worker
LoadCredential=telegram.json:/etc/erp-mac-ia-watchdog/telegram.json
StateDirectory=erp-point-decision
StateDirectoryMode=0700
UMask=0077
# A publication deadline escalates to the operator while retaining leases. Never
# kill a deployment client and release exclusions while its descendants operate.
TimeoutStartSec=infinity
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/opt/pastelerias-erp /run/lock
ReadWritePaths=/run/pastelerias-mac-ia/worker.lock /var/lib/erp-point-archive/.worker.lock /var/lib/erp-cleanup-prepare/.worker.lock /var/lib/erp-point-decision/cleanups/.worker.lock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=512M
TasksMax=128
