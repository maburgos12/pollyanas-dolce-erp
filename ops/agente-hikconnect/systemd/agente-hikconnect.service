[Unit]
Description=Ciclo Hik-Connect Cloud -> ERP Pollyana's Dolce
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
WorkingDirectory=/opt/agente-hikconnect
EnvironmentFile=/opt/agente-hikconnect/.env
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /run/lock/hikconnect-ingesta.lock /opt/agente-hikconnect/.venv/bin/python /opt/agente-hikconnect/main.py --sync-once
SuccessExitStatus=75
Restart=on-failure
RestartSec=30
TimeoutStartSec=240
KillMode=mixed
StandardOutput=journal
StandardError=journal
