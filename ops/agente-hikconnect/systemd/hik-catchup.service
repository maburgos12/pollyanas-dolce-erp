[Unit]
Description=Catch-up diario Hik-Connect -> ERP (recupera marcajes subidos con retraso)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agente-hikconnect
# Sync y catch-up comparten sesion y SQLite; flock los serializa sin parar unidades.
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /run/lock/hikconnect-ingesta.lock /opt/agente-hikconnect/.venv/bin/python /opt/agente-hikconnect/catchup.py --horas 72
SuccessExitStatus=75
TimeoutStartSec=1800
KillMode=mixed
StandardOutput=journal
StandardError=journal
