HIKCONNECT_EMAIL=pasteleriadolceasistencia@outlook.com
HIKCONNECT_PASSWORD=CAMBIAR
HIKCONNECT_REGION=Mexico
HIKCONNECT_LANGUAGE=English

ERP_BASE_URL=https://erp.pollyanasdolce.com
ERP_API_KEY=CAMBIAR
ERP_ENDPOINT=/rrhh/api/asistencia-hik/

SYNC_INTERVAL_SECONDS=300
LOOKBACK_HOURS=12
MAX_PAGES=8
PAGE_SIZE=100
HEADLESS=true

# Alertas solo cuando la recuperación automática agotó el SLO.
HIK_MAYA_WEBHOOK_URL=
HIK_ALERT_WHATSAPP_TO=
HIK_ALERT_EMAIL_TO=
HIK_ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Mapeos puntuales cuando Hik-Connect usa un ID distinto al codigo maestro de nomina.
# Formato: hik=erp,hik2=erp2
EMPLOYEE_CODE_ALIASES=234=337
