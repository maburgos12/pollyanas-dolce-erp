[Unit]
Description=ERP NAS restore verification and verified local backup retention
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/erp-backup-smb-direct/bin/python3 -B /opt/pastelerias-erp/scripts/vps_backup_health.py --verify-only --nas-side --smb-direct --retire-verified-local
TimeoutStartSec=8h
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
