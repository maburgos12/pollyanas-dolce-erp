[Unit]
Description=ERP NAS restore verification and guarded backup rotation
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/pastelerias-erp/scripts/vps_backup_health.py
TimeoutStartSec=8h
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
