--- a/internal/cbm/lsp/py_lsp.c
+++ b/internal/cbm/lsp/py_lsp.c
@@ -55,6 +55,32 @@ void py_lsp_init(PyLSPContext *ctx, CBMArena *arena, const char *source, int sou
     ctx->debug = dbg && dbg[0] && dbg[0] != '0';
 }

+/* Resolve Python relative imports before they become high-confidence LSP
+ * overrides. module_qn includes the source file (__init__ included), so one
+ * leading dot removes that file, two remove its parent as well, and so on.
+ * Preserve an unresolvable QN rather than guessing a same-named target. */
+static const char *py_canonical_import_qn(PyLSPContext *ctx, const char *qn) {
+    if (!qn || qn[0] != '.' || !ctx->module_qn)
+        return qn;
+    const char *tail = qn;
+    size_t prefix_len = strlen(ctx->module_qn);
+    while (*tail == '.') {
+        while (prefix_len > 0 && ctx->module_qn[prefix_len - 1] != '.')
+            prefix_len--;
+        if (prefix_len == 0)
+            return qn; /* Never walk above the project prefix. */
+        prefix_len--; /* Drop the separator and the final module component. */
+        tail++;
+    }
+    if (!*tail)
+        return qn;
+    char *prefix = cbm_arena_strndup(ctx->arena, ctx->module_qn, prefix_len);
+    if (!prefix)
+        return qn;
+    const char *canonical = cbm_arena_sprintf(ctx->arena, "%s.%s", prefix, tail);
+    return canonical ? canonical : qn;
+}
+
 void py_lsp_add_import(PyLSPContext *ctx, const char *local_name, const char *module_qn) {
     if (!ctx || !local_name || !module_qn)
         return;
@@ -72,7 +98,8 @@ void py_lsp_add_import(PyLSPContext *ctx, const char *local_name, const char *mo
         qns[i] = ctx->import_module_qns[i];
     }
     names[ctx->import_count] = cbm_arena_strdup(ctx->arena, local_name);
-    qns[ctx->import_count] = cbm_arena_strdup(ctx->arena, module_qn);
+    qns[ctx->import_count] =
+        cbm_arena_strdup(ctx->arena, py_canonical_import_qn(ctx, module_qn));
     names[new_count] = NULL;
     qns[new_count] = NULL;

