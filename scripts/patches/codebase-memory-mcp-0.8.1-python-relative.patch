diff --git a/tests/test_py_lsp.c b/tests/test_py_lsp.c
index a93fa79..b30c103 100644
--- a/tests/test_py_lsp.c
+++ b/tests/test_py_lsp.c
@@ -1245,7 +1245,64 @@ TEST(pylsp_round6_property_access_chains) {

 /* ── Suite ─────────────────────────────────────────────────────── */

+/* Relative imports must emit project-qualified targets before the parallel
+ * pipeline consumes single-file LSP results. A raw .module.name override
+ * otherwise suppresses the valid IMPORTS-based resolution. */
+TEST(pylsp_relative_import_canonical_targets) {
+    const char *paths[] = {"pkg/reader.py", "pkg/nested/reader.py", "pkg/__init__.py"};
+    const char *sources[] = {
+        "from .services_costos import asignar_costos_filas\n"
+        "def reader(rows):\n    return asignar_costos_filas(rows)\n",
+        "from ..services_costos import asignar_costos_filas\n"
+        "def reader(rows):\n    return asignar_costos_filas(rows)\n",
+        "from .services_costos import asignar_costos_filas\n"
+        "def reader(rows):\n    return asignar_costos_filas(rows)\n"
+    };
+    for (int i = 0; i < 3; i++) {
+        CBMFileResult *r = cbm_extract_file(sources[i], (int)strlen(sources[i]),
+                                           CBM_LANG_PYTHON, "test", paths[i], 0, NULL, NULL);
+        ASSERT_NOT_NULL(r);
+        int hit = find_resolved(r, ".reader", "asignar_costos_filas");
+        ASSERT_GTE(hit, 0);
+        ASSERT_STR_EQ(r->resolved_calls.items[hit].callee_qn,
+                      "test.pkg.services_costos.asignar_costos_filas");
+        cbm_free_result(r);
+    }
+    PASS();
+}
+
+TEST(pylsp_relative_import_module_without_extra_dot) {
+    const char *src = "from . import services_costos\n"
+                      "def reader(rows):\n    return services_costos.asignar_costos_filas(rows)\n";
+    CBMFileResult *r = cbm_extract_file(src, (int)strlen(src), CBM_LANG_PYTHON,
+                                       "test", "pkg/reader.py", 0, NULL, NULL);
+    ASSERT_NOT_NULL(r);
+    ASSERT_EQ(r->imports.count, 1);
+    ASSERT_STR_EQ(r->imports.items[0].module_path, ".services_costos");
+    cbm_free_result(r);
+    PASS();
+}
+
+TEST(pylsp_relative_import_cannot_escape_project) {
+    CBMArena a;
+    cbm_arena_init(&a);
+    CBMTypeRegistry reg;
+    cbm_registry_init(&reg, &a);
+    PyLSPContext ctx;
+    py_lsp_init(&ctx, &a, "", 0, &reg, "test.pkg.reader", NULL);
+    py_lsp_add_import(&ctx, "f", "...outside.f");
+    py_lsp_bind_imports(&ctx);
+    const CBMType *t = py_lsp_lookup_in_scope(&ctx, "f");
+    ASSERT_EQ(t->kind, CBM_TYPE_NAMED);
+    ASSERT_STR_EQ(t->data.named.qualified_name, "...outside.f");
+    cbm_arena_destroy(&a);
+    PASS();
+}
+
 SUITE(py_lsp) {
+    RUN_TEST(pylsp_relative_import_canonical_targets);
+    RUN_TEST(pylsp_relative_import_module_without_extra_dot);
+    RUN_TEST(pylsp_relative_import_cannot_escape_project);
     /* Phase 2 — smoke */
     RUN_TEST(pylsp_smoke_empty);
     RUN_TEST(pylsp_smoke_one_function);
