[Unit]
Description=Read existing ERP Doctor results into sanitized snapshot
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=erp-observer
Environment=DOCKER_CONFIG=/nonexistent
Environment=GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_OPTIONAL_LOCKS=0
ExecStart=/usr/bin/python3 -B /opt/erp-observer/current/ops/erp-observer/collect.py
TimeoutStartSec=75
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/erp-observer-source
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=192M
CPUQuota=10%
TasksMax=32
